classDiagram
class Owner {
  +int id
  +string name
  +string email
  +string phone
  +List~Pet~ pets
  +createPet(name,species,breed,age)
  +removePet(petId)
  +getPets()
  +notify(message)
}

class Pet {
  +int id
  +string name
  +string species
  +string breed
  +int age
  +int ownerId
  +List~Task~ tasks
  +addTask(task)
  +removeTask(taskId)
  +getTasks()
}

class Task {
  +int id
  +string title
  +string description
  +string frequency     // e.g., "daily","weekly"
  +Date dueDate
  +bool completed
  +int petId
  +int ownerId
  +markComplete()
  +snooze(duration)
  +isOverdue(): bool
}

class Scheduler {
  +List~Task~ allTasks
  +scheduleTask(task, datetime)
  +rescheduleTask(taskId, datetime)
  +cancelTask(taskId)
  +getUpcomingTasks(ownerId, days): List~Task~
  +sendReminders()
}

Owner "1" --> "*" Pet : owns
Pet "1" --> "*" Task : has
Scheduler ..> Task : manages
Scheduler ..> Owner : notifies
